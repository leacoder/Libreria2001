---
import { Image, getImage } from 'astro:assets';
import { categories, products } from '../data/products';
import { whatsappUrl } from '../data/business';
import Icon from './Icon.astro';
const items = await Promise.all(products.map(async p => ({ ...p, preview: await getImage({src:p.image,width:720,format:'webp',quality:82}) })));
---
<section class="section products-section" id="section-works" aria-labelledby="products-title" data-gallery>
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">PARA CADA PROYECTO</span><h2 id="products-title">Pequeñas cosas.<br /><em>Grandes posibilidades.</em></h2></div><p>Una selección de nuestros productos.<br />Consultá precio y disponibilidad por WhatsApp.</p></div>
    <div class="gallery-toolbar" data-gallery-controls hidden><div class="filters" role="group" aria-label="Filtrar productos por categoría">{categories.map((c,i) => <button class:list={['filter',{'is-active': i===0}]} type="button" data-filter={c.id} aria-pressed={i===0} aria-controls="product-grid">{c.label}</button>)}</div><p class="gallery-count" role="status" aria-live="polite" data-gallery-count></p></div>
    <div class="product-grid" id="product-grid">
      {items.map((p) => <article class="product-card" data-product data-category={p.category}>
        <a class="product-image-link" href={`/img/portfolio/${p.original}`} data-preview={p.preview.src} data-product-name={p.name} aria-label={`Ampliar imagen de ${p.name}`}>
          <Image src={p.image} alt={p.name} widths={[320,480,720]} sizes="(max-width: 650px) 45vw, (max-width: 900px) 30vw, (max-width: 1336px) 23vw, 292px" width={720} height={550} format="webp" quality={78} loading="lazy" decoding="async" />
          <span class="product-zoom"><Icon name="plus" size={18} /></span>
        </a>
        <div class="product-info"><span class="product-category">{categories.find(c => c.id===p.category)?.label}</span><h3>{p.name}</h3><p>{p.detail}</p><a class="product-consult" href={whatsappUrl(`Hola, vi ${p.name} en la web de Librería 2001. ¿Me pueden confirmar precio y disponibilidad?`)} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-location="product" data-item={p.name}>Consultar <span class="sr-only">por {p.name}</span><Icon name="diagonal" size={15} /></a></div>
      </article>)}
    </div>
    <div class="gallery-more"><button class="button button--outline" type="button" data-show-more hidden>Ver más productos <Icon name="plus" size={18} /></button></div>
    <div class="gallery-help"><span>¿Buscás algo en particular?</span><a href={whatsappUrl('Hola, estoy buscando un producto y quisiera consultar si lo tienen.')} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-location="gallery-help">Contanos qué necesitás <Icon name="arrow" size={18} /></a></div>
  </div>
  <dialog class="product-dialog" aria-labelledby="dialog-title" data-product-dialog><div class="dialog-content"><button class="dialog-close" type="button" aria-label="Cerrar imagen" data-close-dialog><Icon name="close" /></button><img data-dialog-image width="720" height="550" alt="" /><div class="dialog-caption"><h2 id="dialog-title"></h2><p>Imagen de referencia. Consultá disponibilidad.</p><a class="text-link" data-dialog-contact target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-location="product-viewer">Consultar por WhatsApp <Icon name="diagonal" size={16} /></a></div></div></dialog>
</section>
