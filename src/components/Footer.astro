---
import { business, whatsappUrl } from '../data/business';
import { services, servicePath } from '../data/services';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a href="/">Librería <strong>2001</strong></a><p>Lo de todos los días.<br />La atención de siempre.</p><span>Avellaneda, desde 1992.</span></div>
    <div><h2>Encontrá lo que necesitás</h2><ul>{services.map(s => <li><a href={servicePath(s.slug)}>{s.name}</a></li>)}</ul></div>
    <div><h2>Estamos cerca</h2><address>{business.address}<br />{business.premises}<br />{business.city}</address><a class="footer-directions" href={business.maps} target="_blank" rel="noopener noreferrer" data-contact="directions" data-location="footer">Cómo llegar <Icon name="diagonal" size={15} /></a></div>
    <div><h2>Seguimos en contacto</h2><ul><li><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-location="footer">WhatsApp<br /><strong>{business.whatsappDisplay}</strong></a></li><li><a href={business.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li><li><a href={business.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li><li><a href={`mailto:${business.email}`} data-contact="email" data-location="footer">Escribinos por mail</a></li></ul></div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Librería 2001</span><span>Papelería, artística y librería comercial.</span><a href="/#header">Volver arriba ↑</a></div>
</footer>
<a class="floating-contact" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${business.whatsappDisplay}`} data-contact="whatsapp" data-location="floating"><Icon name="chat" size={24} /><span><span>WhatsApp</span><strong>{business.whatsappDisplay}</strong></span></a>
