---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import editorial from '../assets/papeleria-editorial-marca.png';
import ContactLink from '../components/ContactLink.astro';
import ContactSection from '../components/ContactSection.astro';
import ProductGallery from '../components/ProductGallery.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { services,servicePath } from '../data/services';
---
<Base title="Librería 2001 | Librería y papelería en Avellaneda desde 1992" description="Tu librería en Avellaneda desde 1992. Artículos escolares, de oficina y artística, impresiones y copiado de libros contables. Av. Mitre 634, locales 7 y 10.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy"><span class="eyebrow"><span class="little-line"></span> PAPELERÍA · ARTÍSTICA · ESCOLAR</span><h1 id="hero-title">Tu librería<br />en Avellaneda.<br /><em>Desde 1992.</em></h1><p>Para estudiar, trabajar y darle forma a tus ideas.<br class="desktop-break" /> Encontrá lo que necesitás, con la atención de siempre.</p><div class="hero-actions"><ContactLink location="hero" /><a class="hero-secondary" href="#Section-about">Conocé nuestros servicios <Icon name="arrow" size={18} /></a></div><div class="hero-note"><Icon name="pin" size={18} /><span>Av. Mitre 634 · Locales 7 y 10</span></div></div>
      <div class="hero-visual">
        <div class="hero-photo">
          <Image src={editorial} alt="Cuaderno con el logo de Librería 2001 y la frase Tus ideas empiezan acá, desde 1992" widths={[480,720,1000,1440]} sizes="(max-width: 650px) 100vw, 52vw" width={1000} height={1000} fit="cover" format="webp" quality={82} loading="eager" fetchpriority="high" />
          <div class="heritage-seal"><span>DESDE</span><strong>1992</strong><small>AVELLANEDA</small></div>
        </div>
        <div class="photo-caption"><span>Un mundo de posibilidades,</span><em>a la vuelta de casa.</em></div>
      </div>
    </div>
  </section>
  <div class="quick-info" id="section-main"><div class="container quick-info-grid"><div><Icon name="pin" /><span>En el centro de Avellaneda<small>Av. Mitre 634 · Locales 7 y 10</small></span></div><div><Icon name="clock" /><span>Lunes a viernes, 10 a 18 h<small>Sábados, 10 a 13 h</small></span></div><a href={business.maps} target="_blank" rel="noopener noreferrer" data-contact="directions" data-location="quick-info"><span>Vení a conocernos<small>Cómo llegar al local</small></span><Icon name="diagonal" /></a></div></div>
  <section class="section services-section" id="Section-about" aria-labelledby="services-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">MUCHO MÁS QUE PAPEL</span><h2 id="services-title">Lo que necesitás,<br /><em>cerca tuyo.</em></h2></div><p>Materiales y servicios para resolver lo cotidiano y acompañar tu próximo proyecto.</p></div><div class="service-grid">{services.map((s,i)=><a class="service-card" href={servicePath(s.slug)}><div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={31} /></span><span class="service-number">0{i+1}</span></div><h3>{s.name}</h3><p>{s.card}</p><span class="service-card-link">{s.linkLabel} <Icon name="diagonal" size={20} /></span></a>)}</div></div></section>
  <section class="history-section" id="historia" aria-labelledby="history-title"><div class="container history-grid"><div class="history-year" aria-hidden="true"><span>ESTAMOS ACÁ DESDE</span><strong>1992<span>.</span></strong><small>AVELLANEDA, BUENOS AIRES</small></div><div class="history-copy"><span class="eyebrow">LA LIBRERÍA DE SIEMPRE</span><h2 id="history-title">Cambian las ideas.<br /><em>La cercanía queda.</em></h2><p>Desde 1992 somos parte de Avellaneda. Acompañamos el estudio, el trabajo y los proyectos creativos con artículos de librería, materiales de artística y atención personalizada.</p><p>Porque detrás de cada lista, cada apunte y cada idea, hay alguien a quien podemos ayudar.</p><a class="text-link" href="#section-contact">Nos vemos en el local <Icon name="arrow" size={19} /></a></div></div></section>
  <ProductGallery />
  <section class="consult-strip"><div class="container consult-strip-inner"><div><span class="eyebrow">UNA MANO PARA ELEGIR</span><h2>Tu próxima idea<br /><em>empieza con una consulta.</em></h2><p>Mandanos tu lista o contanos qué estás buscando.</p></div><ContactLink location="consult-strip" label="Escribinos por WhatsApp" variant="light" /></div></section>
  <ContactSection />
</Base>
