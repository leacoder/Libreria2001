---
import sansFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, storeSchema } from '../data/business';
import { getImage } from 'astro:assets';
import editorial from '../assets/papeleria-editorial.png';
interface Props { title: string; description: string; schema?: Record<string,unknown>[]; noindex?: boolean; }
const {title,description,schema=[],noindex=false}=Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, business.site).href;
const socialImage = await getImage({ src:editorial,width:1200,height:630,fit:'cover',format:'jpg',quality:80 });
const jsonLd = { '@context':'https://schema.org','@graph':[
  storeSchema,
  {'@type':'WebSite','@id':`${business.site}/#website`,url:`${business.site}/`,name:business.name,inLanguage:'es-AR',publisher:{'@id':storeSchema['@id']}},
  {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:title,description,inLanguage:'es-AR',isPartOf:{'@id':`${business.site}/#website`},about:{'@id':storeSchema['@id']}},
  ...schema,
]};
const configuredAnalyticsId = (import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || 'G-VDGRQ1QPV9').trim();
const analyticsId = configuredAnalyticsId === 'off' ? '' : configuredAnalyticsId;
if (analyticsId && !/^G-[A-Z0-9]+$/.test(analyticsId)) throw new Error('PUBLIC_GOOGLE_ANALYTICS_ID debe ser un ID de medición GA4 válido (G-…).');
const enableAnalytics = import.meta.env.PROD && analyticsId && !noindex;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#243d59" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage.src,business.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Papelería y materiales de artística. Librería 2001, Avellaneda." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')} />
    {enableAnalytics && <script is:inline data-analytics={analyticsId} define:vars={{analyticsId}}>
      // Local previews must never enter production reports.
      if (location.hostname === 'libreria2001.com.ar' || location.hostname === 'www.libreria2001.com.ar') {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', analyticsId, { allow_google_signals:false, allow_ad_personalization_signals:false, page_location:location.origin+location.pathname });
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(analyticsId);
        document.head.append(tag);
      }
    </script>}
  </head>
  <body id="header">
    <a class="skip-link" href="#main">Ir al contenido</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
